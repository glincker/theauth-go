#!/bin/sh
# Mirrors what CI enforces so a failure shows up before the push:
#   1. golangci-lint on issues new since origin/main (CI: --new-from-rev)
#   2. every touched module builds and vets with the workspace OFF, the way
#      the govulncheck jobs load them (catches nested modules that depend on
#      root symbols a release does not have yet)
#   3. govulncheck: third-party module findings fail, stdlib findings warn
#      because they depend on the local Go toolchain version. A govulncheck
#      run that errors (exit other than 0 or 3) fails the push unless
#      THEAUTH_ALLOW_OFFLINE_VULN=1 is set.
# Tests are not run here: CI runs the full suite, including the slow internal/as
# shard under -race. Full local run: GOWORK=off go test -race ./...
# Pushes with no Go, go.mod, go.sum or go.work change skip all of the above.
# Set THEAUTH_SKIP_HOOKS=1 to bypass in an emergency.
. "$(dirname "$0")/lib.sh"
[ "$THEAUTH_SKIP_HOOKS" = "1" ] && exit 0

base=origin/main
git rev-parse --verify -q "$base" >/dev/null || { warn "no $base, skipping"; exit 0; }
changed=$(git diff --name-only "$base"...HEAD)
gochanged=$(printf '%s\n' "$changed" | grep -E '(\.go|go\.mod|go\.sum|go\.work)$' || true)
[ -z "$gochanged" ] && exit 0
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

if command -v golangci-lint >/dev/null 2>&1; then
	golangci-lint run --timeout=3m --new-from-rev="$base" ./... || fail "golangci-lint found new issues"
else
	warn "golangci-lint not installed, skipping lint (CI will run it)"
fi

modules=$(printf '%s\n' "$gochanged" | modules_for_files)
for m in $modules; do
	( cd "$m" && GOWORK=off go build ./... && GOWORK=off go vet ./... ) \
		|| fail "module $m does not build or vet with GOWORK=off"
done

if [ "$THEAUTH_SKIP_VULNCHECK" = "1" ]; then
	exit 0
fi
for m in $modules; do
	rc=0
	out=$( cd "$m" && GOWORK=off go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./... 2>&1 ) || rc=$?
	# `go run` turns any program failure into exit 1 and prints "exit status N". govulncheck exits
	# 3 when it found vulnerabilities, so recover that code from the last output line.
	if [ "$rc" -eq 1 ] && printf '%s\n' "$out" | tail -n 1 | grep -q '^exit status 3$'; then
		rc=3
	fi
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
		printf '%s\n' "$out" | tail -n 15 >&2
		warn "$m: govulncheck did not run to completion (exit $rc), the vulnerability scan did NOT happen"
		if [ "$THEAUTH_ALLOW_OFFLINE_VULN" = "1" ]; then
			warn "$m: continuing because THEAUTH_ALLOW_OFFLINE_VULN=1"
			continue
		fi
		fail "govulncheck failed in $m; fix the network or toolchain and retry, set THEAUTH_ALLOW_OFFLINE_VULN=1 to push without the scan, or THEAUTH_SKIP_VULNCHECK=1 to skip it"
	fi
	if printf '%s\n' "$out" | grep -q '^  Module:'; then
		printf '%s\n' "$out" | grep -B4 -A4 '^  Module:' >&2
		fail "govulncheck found third-party module vulnerabilities in $m"
	fi
	if printf '%s\n' "$out" | grep -q 'Standard library'; then
		warn "$m: stdlib findings with $(go version | cut -d' ' -f3); update the local toolchain"
	fi
done
exit 0
